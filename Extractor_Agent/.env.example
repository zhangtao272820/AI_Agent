# =============================================================================
# Extractor_Agent — 网页抓取 / 结构化抽取 Agent
# 复制为 .env 后填写 QWEN_API_KEY
# 行为默认 → server/utils/extractor_agent_env.ts · MODE SSOT → .env.convergence-modes.example
# =============================================================================

# ── 必填：LLM 密钥 ──
QWEN_API_KEY=                            # 阿里云百炼 API Key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 能力层模型 ──
QWEN_MODEL=qwen-flash-2025-07-28         # T0 文本抽取 / 规划
QWEN_VL_MODEL=qwen-vl-plus               # T3 视觉抽取
QWEN_ENABLE_THINKING=off

# ── 运行档位 ──
EXTRACTOR_MODE=adaptive                  # adaptive | fast | deep
EVO_MODE=convergence                     # convergence | learning | off
EXTRACTOR_LEARNING_MODE=convergence      # convergence | off（路由策略 / 经验回放）

# ── HTTP / WebSocket ──
CRAWLER_PORT=13104
WS_PATH=/_ws

# ── 独立 UI / 直连联网种子（与总管同契约：search → seed_urls → crawl_seeds）──
EXTRACTOR_WEB_SEARCH=1
# SEARXNG_BASE_URL=http://searxng:8080
# EXTRACTOR_WEB_SEARCH_MAX_SEEDS=8
# TAVILY_API_KEY=
# SERPER_API_KEY=

# ── 云抓取兜底（Firecrawl 兼容；推荐自托管 CRW，免商业配额）──
# Docker 栈默认 MCP_BASE_URL=http://crw:3000/v1/scrape（见 Manage-platform compose）
# 本机直跑可改：MCP_BASE_URL=http://127.0.0.1:13114/v1/scrape（勿用 13000，与 Grafana 冲突）
MCP_PROVIDER=firecrawl
MCP_API_KEY=local
MCP_BASE_URL=http://crw:3000/v1/scrape
# MCP_RENDER=on
# EXTRACTOR_MCP_MAX_CALLS=12

# ── 异步队列 ──
# EXTRACTOR_ASYNC_QUEUE=on
# EXTRACTOR_QUEUE_BACKEND=local          # local | redis

# ── 站点补丁 ──
# EXTRACTOR_PATCHES_DIR=./patches
