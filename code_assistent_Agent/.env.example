# =============================================================================
# Code Assist Agent — 代码检索 / 计算 / 仓库操作
# 复制为 .env 后填写 OPENAI_API_KEY
# 行为默认 → server/utils/code_agent_env.ts · MODE SSOT → .env.convergence-modes.example
# =============================================================================

# ── 必填：API 密钥 ──
OPENAI_API_KEY=                          # 阿里云百炼 API Key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 能力层模型 ──
OPENAI_MODEL=qwen-coder-plus             # T2 代码生成 / compute
OPENAI_EMBEDDING_MODEL=text-embedding-v1

# ── 运行档位 ──
EVO_MODE=convergence                     # convergence | learning | off
CODE_LEARNING_MODE=convergence           # convergence | off（向量经验 / 学习闭环）
QWEN_ENABLE_THINKING=off

# ── 独立 UI 改仓（Monaco 写文件/跑命令）──
# WRITE_TOOL_ENABLED=on
# COMMAND_TOOL_ENABLED=on
# CODE_SANDBOX_MODE=subprocess           # off | subprocess | docker
