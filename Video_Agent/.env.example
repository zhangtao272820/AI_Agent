# =============================================================================
# Video_Agent — AI 视频生成（通义万相 + 多 Agent 分镜）
# 复制为 .env 后填写 OPENAI_API_KEY 或 DASHSCOPE_API_KEY
# 能力层模型 SSOT：Manage-platform_Agent/.env.capability-models.example
# =============================================================================

# ── 必填：API 密钥 ──
OPENAI_API_KEY=                          # 阿里云百炼 Key（分镜/质检）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=                       # 万相视频 API（与上二选一或同填）

# ── 文本 Agent 模型 ──
OPENAI_MODEL=qwen-flash-2025-07-28       # T0 分镜 / 提示词 / 质检

# ── HTTP 服务 ──
API_PORT=13111                           # 监听端口（集群标准；独立开发可用 37891）
CORS_ORIGINS=http://localhost:56291,http://127.0.0.1:56291

# ── 通义万相文生视频 ──
WAN_VIDEO_MODEL=wan2.6-t2v               # 主视频模型
WAN_VIDEO_FALLBACK_MODEL=wanx2.1-t2v-plus # 主模型不可用时的降级模型
WAN_VIDEO_SIZE=1280*720                  # 输出分辨率
WAN_VIDEO_DURATION=10                    # 单镜头时长（秒）
VIDEO_USE_MOCK=false                     # true=不调用万相，用占位视频

# ── 质检重试 ──
QA_MAX_FAIL_RETRIES=2                    # 质检不通过后镜头 Agent 最多重试轮数

# ── BGM 伴奏（调用 Music_Agent）──
MUSIC_AGENT_HTTP_URL=http://127.0.0.1:13110  # Music Agent HTTP 地址
BGM_ENABLED=true                         # 是否自动生成 BGM
BGM_DURATION_SECONDS=10                  # BGM 时长（秒）
BGM_MUSIC_KEY=C                          # 调性
BGM_TEMPO_BPM=96                         # 节拍 BPM
BGM_EMOTION=energetic                    # 情绪标签
