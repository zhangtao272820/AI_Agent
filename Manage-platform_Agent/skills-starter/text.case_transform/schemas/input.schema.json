{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["input_data"],
  "properties": {
    "input_data": {
      "type": "object",
      "required": ["text", "mode"],
      "properties": {
        "text": { "type": "string" },
        "mode": { "type": "string", "enum": ["upper", "lower", "title"] }
      },
      "additionalProperties": true
    },
    "context": { "type": "object" }
  },
  "additionalProperties": true
}
