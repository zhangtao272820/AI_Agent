# =============================================================================
# Companion_Agent — 虚拟生活（千问 Character + 纯立绘 GAL）
# 复制为 .env 后填写 DASHSCOPE_API_KEY 或 OPENAI_API_KEY
# 默认值见 backend/app/config.py（须与下方示例语义一致）
# =============================================================================

# ── 必填：API 密钥 ──
DASHSCOPE_API_KEY=                       # 阿里云百炼 Key（对话 / TTS / 立绘文生图）
OPENAI_API_KEY=                          # OpenAI 兼容 Key（与上二选一或同填）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # 北京区；国际区见 README

# ── 角色对话模型 ──
COMPANION_LLM_MODEL=qwen-flash-character-2026-02-26  # 主对话（女主台词）
# 裁决 Judge / 记忆 / 摘要 用的辅模型。留空 = 与 COMPANION_LLM_MODEL 相同（推荐）。
# 勿默认另写 qwen-flash：它常走独立免费额度池，耗尽会 403 FreeTierOnly，主对话仍通但好感/记忆发飘。
COMPANION_AUX_LLM_MODEL=
COMPANION_JUDGE_MODE=hybrid              # rules（纯规则省 Token）| hybrid（推荐）| llm
# hybrid/llm 会调辅模型；若控制台「仅用免费额度」且该模型免费额耗尽 → 游戏内会 toast 提示。
COMPANION_SUMMARY_EVERY_TURNS=10         # 每 N 用户轮才压一次摘要
COMPANION_CONTEXT_KEEP_PAIRS=4           # 世界模式保留最近对话轮数
COMPANION_MEMORY_LLM_ENABLED=true        # 开：保证记忆质量；短敷衍自动跳过
COMPANION_MEMORY_LLM_EVERY_TURNS=3       # 实质发言每隔 N 轮抽一次
COMPANION_MEMORY_LLM_MIN_CHARS=8         # 短于此时只用规则提取

# ── TTS 语音合成 ──
COMPANION_TTS_ENABLED=true               # 是否启用 TTS
COMPANION_TTS_MODEL=qwen3-tts-flash      # 基础音色模型
COMPANION_TTS_INSTRUCT_MODEL=qwen3-tts-instruct-flash  # 带情绪指令的朗读模型
COMPANION_TTS_VOICE=Cherry               # 音色（空则默认 Cherry；苏晚悠等角色以 profile 为准）
COMPANION_TTS_MODE=full                  # off | key_only（省额度）| full（每句有情绪朗读）
COMPANION_TTS_FALLBACK=none              # none | edge | browser（API 超额时兜底）
COMPANION_TTS_SKIP_SHORT_CHARS=20        # full 模式下跳过短句

# ── HTTP 服务 ──
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:13115,http://127.0.0.1:13115  # 前端允许源（Docker 同端口访问含 13115）
API_HOST=0.0.0.0                         # 监听地址
API_PORT=13115                           # 监听端口

# ── 立绘文生图（scripts/gen-sprites-from-manifest.py --generate）──
# COMPANION_IMAGE_MODEL=wanx2.1-t2i-turbo

# 以下有代码默认，一般无需写：
# LLM_TEMPERATURE=0.92  LLM_MAX_TOKENS=512  HISTORY_MAX_TURNS=4

# ── 桌面 exe ──
# 发行面双击 CompanionAgent.exe；密钥放在 %LOCALAPPDATA%\CompanionAgent\.env
# （build_exe.ps1 会在本机首次打包时尝试从仓库 .env 播种）
