# =============================================================================
# Tavern_Agent — 酒馆角色扮演 + 文生图
# 复制为 .env 后填写 OPENAI_API_KEY 或 DASHSCOPE_API_KEY
# 能力层模型 SSOT：Manage-platform_Agent/.env.capability-models.example
# =============================================================================

# ── 必填：API 密钥 ──
OPENAI_API_KEY=                          # 阿里云百炼 Key（对话）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=                       # 生图 API Key（可与上同填）

# ── 对话模型 ──
OPENAI_MODEL=qwen-flash-2025-07-28       # T0 角色对话

# ── 文生图 ──
TAVERN_IMAGE_PROVIDER=auto               # auto | qwen | wanx（auto=按模型名自动选）
TAVERN_IMAGE_MODEL=qwen-image-2.0        # 生图模型名
TAVERN_IMAGE_SIZE=1024*1024              # 输出尺寸
TAVERN_IMAGE_PROMPT_EXTEND=false         # 是否启用提示词扩展
TAVERN_IMAGE_MAX_CONCURRENT=3            # 最大并发生图数

# ── HTTP 与资源 ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSET_DIR=.data/tavern/assets            # 生成图片存储目录
IMAGE_CACHE_JSON=.data/tavern/image_cache.json  # 图片缓存索引
