{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "#agent-shared/*": ["../shared/*"]
    }
  },
  "include": ["scripts/**/*.ts", "utils/**/*.ts", "server/**/*.ts", "../shared/**/*.ts"]
}
