{
  "version": "1.0",
  "description": "总管端 GUI 复杂网页测试 golden（路由 + 执行预期）",
  "cases": [
    {
      "id": "mgr-gui-baidu-search",
      "user": "请用浏览器打开百度，搜索「Python 教程」，点击第一条搜索结果，提取标题和链接。",
      "expectIntent": ["gui", "multi"],
      "expectAgents": ["gui"],
      "forbidAgents": [],
      "note": "站内搜索+点击 → gui(mcp)"
    },
    {
      "id": "mgr-gui-httpbin-form",
      "user": "引擎:stagehand\n打开 https://httpbin.org/forms/post ，在 Customer name 填 lobster_test，截图。",
      "expectIntent": ["gui"],
      "expectAgents": ["gui"],
      "note": "填表 → stagehand"
    },
    {
      "id": "mgr-no-gui-news-summary",
      "user": "最近一周人工智能政策有什么新闻，给我摘要就行",
      "expectIntent": ["db", "rag", "multi", "admin"],
      "forbidAgents": ["gui"],
      "note": "摘要 → web_search/crawler，非 gui"
    },
    {
      "id": "mgr-multi-gov-crawler",
      "user": "打开 https://www.gov.cn/ 提取 3 条资讯标题，并生成简短报告",
      "expectIntent": ["multi", "crawler"],
      "expectAgents": ["crawler"],
      "forbidAgents": ["gui"],
      "note": "静态列表 → crawler"
    },
    {
      "id": "mgr-gui-antd",
      "user": "打开 Ant Design 表单示例，在用户名输入框填写 test_user",
      "expectIntent": ["gui", "multi"],
      "expectAgents": ["gui"],
      "note": "SPA 表单 → gui(stagehand)"
    }
  ]
}
