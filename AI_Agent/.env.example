# =============================================================================
# AI_Agent — 实时虚拟化身（语音对话；默认假口型，无需 GPU）
# 复制为 .env 后填写 DASHSCOPE_API_KEY 或 OPENAI_API_KEY
# 能力层模型 SSOT：Manage-platform_Agent/.env.capability-models.example
# =============================================================================

# ── 必填：API 密钥 ──
DASHSCOPE_API_KEY=                       # 阿里云百炼 Key（与 OPENAI_API_KEY 二选一或同填）
OPENAI_API_KEY=                          # OpenAI 兼容 Key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # 兼容端点（北京区）

# ── 能力层模型 ──
LLM_MODEL=qwen-plus-2025-01-25           # T1 对话模型
ASR_MODEL=qwen3-asr-flash-2025-09-08     # T4 语音识别
TTS_MODEL=qwen-tts                       # T4 语音合成模型名
TTS_VOICE=Cherry                         # TTS 音色（见百炼控制台）
LLM_MAX_TOKENS=96                       # 单次回复 token 上限（语音场景宜短）
LLM_TEMPERATURE=0.35                    # 越低回复越稳定一致（0.2–0.5）

# ── 系统提示词 ──
SYSTEM_PROMPT=你是虚拟数字人助手「小艾」，对外说话风格固定、简短、口语化。硬性规则：每次只回答1到2句话，总字数不超过45字；先直接回应用户，不要展开背景、不要聊天气、不要主动寒暄延伸。禁止 emoji、颜文字、感叹号连用、省略号。相同或相近问候（如「你好」「在吗」「嗨」）必须固定回复：「你好，我是小艾，有什么可以帮你？」其他问题也先给结论，最多再补一句，保持每次措辞稳定。

# ── 流式输出（文字 + 语音更顺滑）──
STREAM_LLM=true                          # LLM 流式输出
STREAM_TTS=true                          # TTS 流式播放
STREAM_TTS_API=false                     # true=走 TTS 流式 API；false=分块合成
STREAM_DELTA_THROTTLE_MS=60              # 流式 delta 节流间隔（ms）
TTS_FIRST_CHUNK_CHARS=8                  # 首段 TTS 最少字符数
TTS_PAUSE_MIN_CHARS=6                    # 句间停顿最少字符数
TTS_PARALLEL_WORKERS=2                   # TTS 并行合成 worker 数

# ── 对口型（默认关闭 GPU 真对口型；待机视频 + TTS 音量假口型）──
LIP_SYNC_MODE=client_rhythm              # client_rhythm=无 GPU | local_ultralight=本地真对口型 | cached_s2v=万相
# 启用 local_ultralight 时再取消注释：
# LIPSYNC_SERVICE_URL=http://127.0.0.1:8091
# LIPSYNC_BACKEND=ultralight
# LIPSYNC_STREAM_FRAMES=true
# LIPSYNC_TIMEOUT_SEC=600

# ── 静态资源 ──
ASSETS_DIR=assets                        # 资源根目录（相对项目根）
AVATAR_VIDEO_PATH=video/ai.mp4           # 默认循环视频
AVATAR_IMAGE_PATH=video/avatar_frame.jpg # 静态封面帧

# ── HTTP 服务 ──
API_HOST=0.0.0.0                         # 监听地址
API_PORT=8080                            # 监听端口（Docker 常映射 13112）
CORS_ORIGINS=http://localhost:13112,http://127.0.0.1:13112,http://localhost:5174,http://127.0.0.1:5174

# ── Docker 部署（取消注释）──
# ASSETS_DIR=/app/assets
# AVATAR_VIDEO_PATH=/app/video/ai.mp4
