# 本地对口型微服务环境变量（Docker / 直跑）

LIPSYNC_PORT=8091
LIPSYNC_BACKEND=ultralight
LIPSYNC_PREFER_CUDA=true
LIPSYNC_FACE_VIDEO=/app/video/ai.mp4

# Ultralight 数据集（Docker 内默认 /data/ultralight）
ULTRALIGHT_DATA_PATH=/data/ultralight

# Wav2Lip 回退（可选）
# WAV2LIP_ROOT=/opt/Wav2Lip

# MuseTalk（可选；推荐 MUSETALK_PYTHON 指向宿主机 conda）
# MUSETALK_ROOT=/opt/MuseTalk
# MUSETALK_PYTHON=C:/miniconda3/envs/MuseTalk/python.exe
# MUSETALK_VERSION=v15
# MUSETALK_USE_FLOAT16=true
# MUSETALK_BBOX_SHIFT=0

# Docker 构建：1=安装 onnxruntime-gpu
# LIPSYNC_GPU=0
