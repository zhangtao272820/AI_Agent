# =============================================================================
# Multimodal_Agent — 多模态理解（图像/语音/文本）
# 复制为 .env 后填写 OPENAI_API_KEY 或 DASHSCOPE_API_KEY
# 能力层模型 SSOT：Manage-platform_Agent/.env.capability-models.example
# =============================================================================

# ── 必填：API 密钥 ──
OPENAI_API_KEY=                          # 阿里云百炼 Key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=                       # 与 OPENAI_API_KEY 二选一或同填

# ── 能力层模型 ──
QWEN_VL_MODEL=qwen-vl-plus               # T3 视觉理解
QWEN_HELPER_MODEL=qwen-flash-2025-07-28  # T0 精炼/辅助问答
QWEN_ASR_MODEL=qwen3-asr-flash-2025-09-08 # T4 语音识别
QWEN_TEXT_MODEL=qwen-flash-2025-07-28  # T0 纯文本问答
USE_HELPER_FOR_VISION=true               # true=视觉任务先用 helper 精炼再 VL
VL_MAX_TOKENS=600                        # 视觉模型 max tokens
HELPER_MAX_TOKENS=360                    # helper 模型 max tokens

# ── HTTP 服务 ──
API_PORT=13107                           # 监听端口
CORS_ORIGINS=http://localhost:13107,http://127.0.0.1:13107
MULTIMODAL_FRONTEND_DIST=                # 内置前端 dist 路径（空=开发模式）

# ── 关联 Agent UI 地址（跳转/联动）──
MUSIC_AGENT_UI_URL=http://127.0.0.1:13110
VIDEO_AGENT_UI_URL=http://127.0.0.1:13111

# ── 开发兜底 ──
USE_MOCK_WHEN_NO_KEY=false               # true=无 Key 时返回 mock 响应
