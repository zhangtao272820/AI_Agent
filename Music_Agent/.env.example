# =============================================================================
# Music_Agent — AI 音乐生成 / MIDI / 播放
# 复制为 .env 后填写 OPENAI_API_KEY 或 DASHSCOPE_API_KEY
# 路线图见 doc/瘦身与能力路线图.md
# =============================================================================

# ── 必填：API 密钥 ──
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 能力层模型 ──
OPENAI_MODEL=qwen-flash-2025-07-28
QWEN3_VL_MODEL=qwen3-vl-plus
QWEN_OMNI_MODEL=qwen3.5-omni-plus

# ── HTTP 服务 ──
API_PORT=13110
CORS_ORIGINS=http://localhost:13110,http://127.0.0.1:13110

# ── MIDI / 音频渲染 ──
MIDI_RENDER_WAV=true
MIDI_RENDER_MP3=false
FLUIDSYNTH_PATH=fluidsynth
FFMPEG_PATH=ffmpeg
SOUNDFONT_SF2_PATH=/usr/share/sounds/sf2/FluidR3_GM.sf2

# ── 流式与播放 ──
STREAM_MODEL_THINKING=true
ENABLE_PLAYBACK_OMNI_INSIGHT=false

# ── Phase 1：上传能力 ──
ENABLE_AUDIO_REMIX=false
ENABLE_MIDI_SWAP=true

# ── MIDI 换音色 ──
REMIX_MIDI_APPLY_ROLE_MIX=true
REMIX_MIDI_RENDER_GAIN=0.58
REMIX_MIDI_RENDER_REVERB=true

# ── Phase 2：乐理工具 ──
ENABLE_MUSIC_THEORY=true

# ── Phase 3：Demucs 分轨（CPU）；神经 BGM 需 GPU，默认关闭 ──
ENABLE_DEMUCS_STEMS=true
DEMUCS_MODEL=htdemucs
DEMUCS_STEMS_MAX_SECONDS=300

# 作曲后端：rule（CPU 推荐）| neural | auto
COMPOSE_BACKEND=rule
NEURAL_MUSIC_ENABLED=false
NEURAL_PRELOAD=false
NEURAL_ENGINE=stable_audio
NEURAL_MODEL_ID=facebook/musicgen-small
STABLE_AUDIO_MODEL_ID=stabilityai/stable-audio-open-1.0
STABLE_AUDIO_MAX_DURATION_GPU=30
STABLE_AUDIO_INFERENCE_STEPS=100
NEURAL_CPU_FALLBACK=false

# Docker 模型缓存（compose volume 已挂载）
# HF_HOME=/music/.cache/huggingface
# TORCH_HOME=/music/.cache/torch

# GPU 镜像构建：MUSIC_AGENT_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
# 启用神经 BGM：NEURAL_MUSIC_ENABLED=true COMPOSE_BACKEND=neural
